# exl3-serve systemd unit template. Placeholders (@ROOT@, @TRITON_CACHE@) are filled in by
# scripts/install-service.sh. Installed as a USER service by default (systemctl --user).
[Unit]
Description=exl3-serve — ExLlamaV3 + TabbyAPI OpenAI-compatible LLM server
After=network-online.target
Wants=network-online.target
# If the model fails to load (e.g. cache_mode/context too large for VRAM), STOP after a couple of
# tries. A tight restart loop of failed CUDA allocations can wedge the driver into an ERR! state
# that only a reboot clears — so give up and surface the failure instead of hammering the GPU.
StartLimitIntervalSec=120
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=@ROOT@/tabbyAPI
Environment=TRITON_CACHE_DIR=@TRITON_CACHE@
Environment=HF_HUB_ENABLE_HXET=0
# Render the repo-root config (substituting @MODEL_DIR@) and mirror the
# sampler-override presets into the TabbyAPI dir on each start. Same script
# scripts/serve.sh uses, so both launch paths substitute identically.
# Set EXL3_MODEL_DIR above if the models do not live in @ROOT@/models.
ExecStartPre=@ROOT@/scripts/render-config.sh
ExecStart=@ROOT@/.venv/bin/python main.py
# Compile the triton kernels via a throwaway request so the first real request isn't cold.
ExecStartPost=@ROOT@/scripts/warmup.sh
# Restart only on unexpected crashes of an already-loaded server — NOT to retry a config that can't
# fit. RestartSec is deliberately long so any retry can't become a GPU-wedging tight loop; the
# StartLimit above caps total attempts.
Restart=on-failure
RestartSec=30
# Model load + first-time kernel JIT can take a few minutes.
TimeoutStartSec=600

[Install]
WantedBy=default.target
